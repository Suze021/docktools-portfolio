  },
  {
   "id": 5,
   "type": "stat",
   "title": "Containers (último sinal)",
   "description": "Some daqui o container que não existe mais; o alerta 'container parado' cobre esse caso.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (name) (time() - container_last_seen{name=~\"docktools-.*|portainer|openclaw|ollama|pin-seeu-.*\"})",
     "legendFormat": "{{name}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "range",
       "options": {
        "from": 0,
        "to": 90,
        "result": {
         "text": "de pé",
         "color": "green",
         "index": 0
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 90,
        "to": 1000000000000.0,
        "result": {
         "text": "PARADO",
         "color": "red",
         "index": 0
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])))",
     "legendFormat": "CPU",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 95
       }
      ]
     },
     "max": 100,
     "min": 0
    },
    "overrides": []
   }
  },
  {
