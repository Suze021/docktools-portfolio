{
 "uid": "casa-emergencia",
 "title": "Emergência",
 "tags": [
  "servidor-de-casa"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Sites (vistos de fora, pelo túnel)",
   "description": "Sonda a cada minuto nas URLs públicas: pega túnel, DNS e app. logs/portainer contam como no ar com 401 (é o basic auth).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (job) (label_replace(probe_success, \"job\", \"$1\", \"job\", \"integrations/blackbox/(.*)\"))",
     "legendFormat": "{{job}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "NO AR",
         "color": "green",
         "index": 0
        }
       }
      },
      {
       "type": "value",
       "options": {
        "0": {
         "text": "FORA",
         "color": "red",
         "index": 0
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Energia",
   "description": "Na bateria = queda de energia em casa.",
