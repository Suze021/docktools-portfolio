  {
   "id": 10,
   "type": "logs",
   "title": "Erros recentes nos containers",
   "datasource": {
    "type": "loki",
    "uid": "P8E80F9AEF21F6940"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "P8E80F9AEF21F6940"
     },
     "expr": "{job=\"docker\"} |~ \"(?i)(error|erro |fatal|panic|exception|unhandled|refused|timeout)\" != \"level=info\"",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "showLabels": false,
    "showCommonLabels": false,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  },
  {
   "id": 11,
   "type": "logs",
   "title": "Sistema: túnel, runner, ssh, docker, kernel, vigia de rede",
   "datasource": {
    "type": "loki",
    "uid": "P8E80F9AEF21F6940"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "P8E80F9AEF21F6940"
     },
     "expr": "{job=\"journal\"} | level=~\"emerg|alert|crit|err|warning\" or unit=\"net-watchdog.service\"",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
