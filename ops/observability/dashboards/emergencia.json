   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(node_hwmon_temp_celsius{chip=\"platform_coretemp_0\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
