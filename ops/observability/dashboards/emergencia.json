    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(node_power_supply_capacity{power_supply=\"BAT1\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
