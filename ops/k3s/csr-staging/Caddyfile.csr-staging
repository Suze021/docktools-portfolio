casa-dev.docktools.dev {
    encode zstd gzip
    reverse_proxy 172.17.0.1:30081 csr-staging-app:3000 {
        lb_policy first
        lb_try_duration 2s
        lb_try_interval 250ms
        fail_duration 10s
        max_fails 1
        unhealthy_status 5xx

        transport http {
            dial_timeout 500ms
        }
    }
}
